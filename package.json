{
  "name": "setupless/rest",
  "description": "An experimental, PostgREST-inspired REST API for SQLite",
  "license": "Apache-2.0",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "check": "biome check .",
    "dev": "bun --watch src/cli.ts",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "bun dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "elysia": "^1.4.29"
  }
}
