{
  "name": "setupless/rest",
  "description": "An experimental, PostgREST-inspired REST API for SQLite",
  "license": "Apache-2.0",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "build:e2e-fixture": "bun build test/e2e/auth-server.ts --target=bun --outdir=dist/e2e",
    "check": "biome check .",
    "dev": "bun --watch src/cli.ts",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "bun dist/cli.js",
    "test": "bun test src test/*.test.ts",
    "test:coverage": "bun test src test/*.test.ts --coverage --randomize --timeout 15000 && bun scripts/check-coverage.ts",
    "test:e2e": "bun run build && bun run test:e2e:built",
    "test:e2e:built": "bun run build:e2e-fixture && bun test test/e2e",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "elysia": "^1.4.29"
  }
}
